# Copy this file to apps/gallery/.env.local and fill in values from your Firebase project settings.
# These are NOT secret (Firebase client config is safe to expose) — security is enforced by
# Firestore security rules and Auth authorized domains, not by hiding these values.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
