rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// (or paste into Firebase Console → Firestore Database → Rules)
service cloud.firestore {
  match /databases/{database}/documents {

    match /works/{workId} {
      allow read: if true;

      // Metadata (title/description/etc.) is never written from the client —
      // it's created/edited manually via the Firebase Console when a work is
      // added (see CONTRIBUTING.md). The one exception is starCount, which
      // moves by exactly +/-1 alongside a stars/{uid} create or delete below.
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['starCount'])
                    && (
                      request.resource.data.starCount == resource.data.starCount + 1 ||
                      request.resource.data.starCount == resource.data.starCount - 1
                    );
      allow create, delete: if false;

      match /stars/{uid} {
        allow read: if true;
        allow create: if request.auth != null
                      && request.auth.uid == uid
                      && request.resource.data.uid == uid
                      && request.resource.data.workId == workId;
        allow delete: if request.auth != null && request.auth.uid == uid;
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
                      && request.resource.data.authorUid == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() < 1000;
        allow update, delete: if request.auth != null
                               && request.auth.uid == resource.data.authorUid;
      }
    }
  }
}
